# Copy this file to .env and fill in real values.
# See README.md "Deployment" section for full instructions.

# --- Database -----------------------------------------------------------
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres — Neon/Supabase/Railway/RDS), after switching the
# `provider` in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Admin account (created by `npm run db:seed`) ------------------------
ADMIN_NAME="Gelin Home Admin"
ADMIN_EMAIL="admin@gelinhome.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- Auth -----------------------------------------------------------------
# Random secret used to sign the admin session cookie (JWT).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
